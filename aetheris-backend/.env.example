# Referência: defina no ambiente da hospedagem; npm start não lê .env automaticamente.
NODE_ENV=production
PORT=3000
TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
TURSO_AUTH_TOKEN=
JWT_SECRET=
ADMIN_USER_ID=
# Migração opcional: nome EXATO de uma conta existente antes de iniciar.
# ADMIN_USERNAME=
# Somente se existir exatamente um proxy confiável na frente do aplicativo:
# TRUST_PROXY=1
